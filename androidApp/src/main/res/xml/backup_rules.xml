<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de Auto Backup para Android 11 (API 30) y anteriores.

   Con `android:allowBackup="false"` en el manifiesto este fichero queda inerte: el sistema no copia
   nada. Se mantiene con las exclusiones explícitas para que la intención esté escrita en los dos
   sitios y para que, si alguna vez se reactivara la copia, el comportamiento por defecto no fuese
   exponer los datos clínicos (SECURITY_MOBILE §Persistencia).

   Las reglas del equivalente moderno están en `data_extraction_rules.xml` (API 31+), que además es el
   único sitio donde se corta la transferencia entre dispositivos.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
