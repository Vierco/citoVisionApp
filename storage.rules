rules_version = '2';

// Reglas de Firebase Storage de citoVision (SPEC-0005, ADR-0001).
//
// Las imágenes se suben a `analyses/{ownerUid}/{analysisId}.<ext>`, así que el dueño va en el propio
// path y la regla lo compara con el usuario del token.
//
// Aviso: la URL de descarga que devuelve la subida incorpora un *download token* y da acceso al objeto
// sin evaluar estas reglas. Esa URL solo se guarda dentro del documento Firestore del análisis, que sí
// está protegido; es una desviación asumida para el MVP (documentada en SPEC-0005).
service firebase.storage {
  match /b/{bucket}/o {

    match /analyses/{ownerUid}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == ownerUid;

      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Todo lo demás queda cerrado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
