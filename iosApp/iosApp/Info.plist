<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Obligatoria para Compose Multiplatform: sin ella iOS limita la app a 60 FPS en pantallas
	     ProMotion (120 Hz) y Compose aborta al arrancar con IllegalStateException desde
	     PlistSanityCheck ("doesn't have a valid CADisableMinimumFrameDurationOnPhone entry"). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>citoVision</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Las versiones vienen de los ajustes de compilación y no escritas aquí a mano: con
	     `GENERATE_INFOPLIST_FILE = NO` manda este fichero, así que un literal dejaría inertes
	     `MARKETING_VERSION` y `CURRENT_PROJECT_VERSION`. Importa porque **TestFlight rechaza toda build
	     cuyo `CFBundleVersion` ya se haya subido**, y ese número hay que poder cambiarlo desde Xcode. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Cumplimiento de exportación. La app solo usa el HTTPS/TLS del sistema para hablar con Firebase,
	     que es criptografía exenta. Declararlo aquí evita que App Store Connect lo pregunte en cada
	     subida; si algún día se añadiera cifrado propio, habría que revisar esta declaración. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google Sign-In (SPEC-0001 RF-2, ADR-0006). El SDK de Google lee `GIDClientID` de aquí, así que no
	     hace falta configurarlo por código. Es el cliente OAuth de iOS del proyecto Firebase: un
	     identificador público, igual que el `google-services.json` de Android que ya está versionado. -->
	<key>GIDClientID</key>
	<string>661374449110-ck5ipj45roahh6ogi8m07rjc7j3l5q8f.apps.googleusercontent.com</string>
	<!-- Esquema inverso del cliente OAuth: por él vuelve el flujo de Google a la app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.661374449110-ck5ipj45roahh6ogi8m07rjc7j3l5q8f</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
